# Server Configuration
PORT=3000
HOST=localhost
NODE_ENV=development

# Database Configuration (will be used in later articles)
DB_TYPE=mongodb
DB_CONNECTION_STRING=mongodb://localhost:27017
DB_NAME=taskapi

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=text

# Feature Flags (will be used in later articles)
ENABLE_CACHING=true
ENABLE_METRICS=true
ENABLE_HEALTH_CHECKS=true

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
CORS_CREDENTIALS=true